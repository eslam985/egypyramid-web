# نسخ إلى .env.local — الرابط الرسمي للموقع (مهم جداً للـ canonical و JSON-LD)

NEXT_PUBLIC_SITE_URL=https://egypyramid.vercel.app

# روابط حساباتك الحقيقية (مفصولة بفاصلة) — تظهر في Organization.sameAs فقط عند التعبئة
# NEXT_PUBLIC_BRAND_SAME_AS=https://t.me/yourchannel,https://twitter.com/yourhandle
